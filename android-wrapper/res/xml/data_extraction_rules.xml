<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: what the Google backup and phone-to-phone transfer copy while the owner allows device backup
     (DeviceBackupAgent). Everything except the over-the-air web bundle and its state, which belong to the APK installed
     on this phone, and the switch itself, so a restored phone starts with it off. A Google copy is made only when the
     phone can encrypt it end to end (a screen lock is set). -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="file" path="live/" />
        <exclude domain="sharedpref" path="lifemax_live.xml" />
        <exclude domain="sharedpref" path="lifemax_device_backup.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="live/" />
        <exclude domain="sharedpref" path="lifemax_live.xml" />
        <exclude domain="sharedpref" path="lifemax_device_backup.xml" />
    </device-transfer>
</data-extraction-rules>
