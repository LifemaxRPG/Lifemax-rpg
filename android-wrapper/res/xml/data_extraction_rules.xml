<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: what the Google backup and phone-to-phone transfer copy when the owner allows device backup
     (DeviceBackupAgent). Everything except the over-the-air web bundle and its state, which belong to the APK installed
     on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="live/" />
        <exclude domain="sharedpref" path="lifemax_live.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="live/" />
        <exclude domain="sharedpref" path="lifemax_live.xml" />
    </device-transfer>
</data-extraction-rules>
